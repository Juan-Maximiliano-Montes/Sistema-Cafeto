# ==========================================================================
# Sistema Cafeto · Variables de entorno del frontend (Vite)
# --------------------------------------------------------------------------
# Copiá este archivo como `.env.local` (no se sube a git) para desarrollo, o
# cargá las mismas variables en Vercel → Project → Settings → Environment
# Variables. Vite las incrusta al compilar: si las cambiás en Vercel, hacé
# "Redeploy" para que tomen efecto.
#
# Sin ninguna variable, la app usa el flujo local de siempre:
#   API  → http://localhost:8000/api/movil
#   Web  → http://localhost:8000  (fotos /media/ y enlaces al panel completo)
# ==========================================================================

# Origen web de Django (sin barra final). Se usa para las fotos /media/... y
# los enlaces "Panel completo". En la demo con túnel: la URL https de cloudflared.
# VITE_DJANGO_WEB=https://ejemplo-de-tunel.trycloudflare.com

# URL completa de la API móvil. Si se omite, se arma como VITE_DJANGO_WEB + /api/movil.
# Si definís sólo esta, VITE_DJANGO_WEB se deriva sola quitando el sufijo /api/movil.
# VITE_API_URL=https://ejemplo-de-tunel.trycloudflare.com/api/movil

# Sólo para `npm run dev` / `npm run preview`: si es "true", Vite reenvía /api y
# /media hacia Django (evita CORS en local). No tiene efecto en Vercel.
# VITE_USAR_PROXY=false

# Destino del proxy de Vite cuando VITE_USAR_PROXY=true (por defecto http://127.0.0.1:8000).
# CAFETO_DJANGO_URL=http://127.0.0.1:8000
